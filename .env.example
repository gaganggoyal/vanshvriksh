DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-openssl-rand-hex-32"
# Public origin (production: https://meravansh.lol)
APP_URL="http://localhost:3000"

# local | resend | smtp
EMAIL_DELIVERY="local"
EMAIL_FROM="Mera Vansh <noreply@meravansh.lol>"

# Set true to show one-click demo logins (disable in production)
ALLOW_DEMO="true"   # demo families are isolated from real ones and reset nightly

# Resend
# EMAIL_DELIVERY="resend"
# RESEND_API_KEY="re_..."

# SMTP (any provider: Zoho, Google Workspace, SES, Brevo…)
# EMAIL_DELIVERY="smtp"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"          # 465 → implicit TLS; override with SMTP_SECURE
# SMTP_USER=""
# SMTP_PASS=""

# The dev "letterbox" shows sign-in codes to whoever requested them. It is off in
# production unless ALLOW_LETTERBOX=true — never enable that on a public server.
# ALLOW_LETTERBOX="false"

# Optional SpaceXAI (xAI) for match explanations
# XAI_API_KEY=""
