generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  locale        String    @default("en")
  kinNotifiedAt DateTime?
  /// scrypt hash; empty until the user chooses a password (email codes always work).
  passwordHash  String    @default("")
  passwordSetAt DateTime?
  /// Bumped when the password changes, so sessions signed before it stop working.
  sessionVersion Int      @default(0)
  /// Email me when someone in another family's tree may be one of my relatives.
  notifyMatches Boolean   @default(true)
  /// Person in another tree this user was invited as; linked on onboarding.
  invitePersonId String   @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tree          Tree?
  claimedPerson Person?   @relation("ClaimedBy")
}

model Tree {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("Family tree")
  /// Shared demo family: matched and searched only among other demo families, reset nightly.
  isDemo    Boolean  @default(false)
  /// Remembered (departed) ancestors can be found by other families' searches. Living people never are.
  discoverable Boolean @default(true)
  createdAt DateTime @default(now())
  people    Person[]
}

model Person {
  id               String   @id @default(cuid())
  treeId           String
  tree             Tree     @relation(fields: [treeId], references: [id], onDelete: Cascade)
  claimedByUserId  String?  @unique
  claimedBy        User?    @relation("ClaimedBy", fields: [claimedByUserId], references: [id])
  isRoot           Boolean  @default(false)
  givenName        String
  familyName       String   @default("")
  nativeName       String   @default("")
  alsoKnownAs      String   @default("")
  gender           String   @default("UNKNOWN")
  birthDate        String?
  birthYear        Int?
  birthPlace       String   @default("")
  deathDate        String?
  isLiving         Boolean  @default(true)
  gotra            String   @default("")
  village          String   @default("")
  notes            String   @default("")
  normalizedGiven  String   @default("")
  normalizedFamily String   @default("")
  /// Phonetic keys of every name (Latin, transliterated native script, aka), space-separated.
  searchKey        String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  relFrom  Relationship[] @relation("RelFrom")
  relTo    Relationship[] @relation("RelTo")
  matchesA Match[]        @relation("MatchA")
  matchesB Match[]        @relation("MatchB")

  @@index([treeId])
  @@index([normalizedFamily, birthYear])
  @@index([normalizedGiven, birthYear])
}

model Relationship {
  id        String   @id @default(cuid())
  treeId    String
  type      String
  fromId    String
  toId      String
  from      Person   @relation("RelFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        Person   @relation("RelTo", fields: [toId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([type, fromId, toId])
  @@index([treeId])
  @@index([fromId])
  @@index([toId])
}

model Match {
  id          String   @id @default(cuid())
  personAId   String
  personBId   String
  personA     Person   @relation("MatchA", fields: [personAId], references: [id], onDelete: Cascade)
  personB     Person   @relation("MatchB", fields: [personBId], references: [id], onDelete: Cascade)
  score       Int
  reasons     String
  status      String   @default("PENDING")
  confirmedBy String   @default("")
  /// auto (matching engine) | search (a family found them) | invite (invited as this person)
  source      String   @default("auto")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([personAId, personBId])
  @@index([status])
}

model AuthChallenge {
  id           String    @id @default(cuid())
  email        String
  /// EMAIL (code + link in one letter); MAGIC is the older link-only row
  type         String
  /// signin | signup | reset | invite
  purpose      String    @default("signin")
  /// Hash of the link token.
  tokenHash    String
  /// Keyed hash of the 6-digit code sent in the same letter; either one works, once.
  codeHash     String    @default("")
  expiresAt    DateTime
  attempts     Int       @default(0)
  consumedAt   DateTime?
  previewToken String    @default("")
  /// Set on invite links that name a person in the inviter's tree.
  invitePersonId String  @default("")
  createdAt    DateTime  @default(now())

  @@index([email, type])
  @@index([email, purpose])
  @@index([tokenHash])
}

model EmailOutbox {
  id           String   @id @default(cuid())
  to           String
  subject      String
  html         String
  text         String
  purpose      String
  previewToken String   @default("")
  createdAt    DateTime @default(now())

  @@index([to])
  @@index([previewToken])
}
